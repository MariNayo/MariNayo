      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.impute import SimpleImputer\n",
        "\n",
        "# Caricamento dei dati (assumendo che 'df' sia già definito)\n",
        "cluster_data = df[['AZN01_Provincia', 'Descrizione_Settore_Livello3', 'Descrizione_Merceologie_Livello4', 'ROA-NETTO 2022']].copy()\n",
        "\n",
        "# Gestione dei valori mancanti solo per ROA-NETTO 2022\n",
        "imputer = SimpleImputer(strategy='mean')\n",
        "cluster_data[['ROA-NETTO 2022']] = imputer.fit_transform(cluster_data[['ROA-NETTO 2022']])\n",
        "\n",
        "# Codifica one-hot delle variabili categoriche\n",
        "cluster_data = pd.get_dummies(cluster_data, columns=['AZN01_Provincia', 'Descrizione_Settore_Livello3', 'Descrizione_Merceologie_Livello4'], drop_first=True)\n",
        "\n",
        "# Standardizzazione della colonna numerica\n",
        "scaler = StandardScaler()\n",
        "cluster_data[['ROA-NETTO 2022']] = scaler.fit_transform(cluster_data[['ROA-NETTO 2022']])\n",
        "\n",
        "# Metodo del gomito per determinare il numero ottimale di cluster\n",
        "wcss = []  # Within-cluster sum of squares\n",
        "for i in range(1, 11):\n",
        "    kmeans = KMeans(n_clusters=i, n_init=10, random_state=42)\n",
        "    kmeans.fit(cluster_data)\n",
        "    wcss.append(kmeans.inertia_)\n",
        "\n",
        "# Visualizzazione del metodo del gomito\n",
        "plt.plot(range(1, 11), wcss, marker='o')\n",
        "plt.title('Metodo del Gomito')\n",
        "plt.xlabel('Numero di Cluster')\n",
        "plt.ylabel('WCSS')\n",
        "plt.show()\n",
        "\n",
        "# Definizione del numero ottimale di cluster (sostituire con il valore corretto dal grafico del gomito)\n",
        "n_clusters = 3\n",
        "kmeans = KMeans(n_clusters=n_clusters, n_init=10, random_state=42)\n",
        "cluster_labels = kmeans.fit_predict(cluster_data)\n",
        "\n",
        "# Aggiunta delle etichette dei cluster al DataFrame originale\n",
        "df['Cluster'] = cluster_labels\n",
        "\n",
        "# Visualizzazione dei risultati del clustering\n",
        "print(df[['Azienda_x', 'Cluster']])\n",
        "print(df.groupby('Cluster')['ROA-NETTO 2022'].describe())\n"
      ],
